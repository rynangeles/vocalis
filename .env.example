# Vocalis local configuration.
# Copy this file to .env. The application also starts with these defaults
# when .env is absent. Do not commit .env.

APP_NAME=Vocalis
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=7860

# mock keeps local development independent of VoxCPM2.
# voxcpm is the production provider and requires VOXCPM_MODEL_PATH.
MODEL_PROVIDER=mock
VOXCPM_MODEL_PATH=

VOCALIS_DATA_DIR=./data
VOCALIS_OUTPUT_DIR=./output
VOCALIS_UPLOAD_DIR=./uploads
VOCALIS_LOG_DIR=./logs
# SQLite history file. Development keeps it in the project data directory.
# Production can use an absolute path such as /opt/vocalis/data/history.db.
VOCALIS_DATABASE_PATH=./data/history.db

MAX_QUEUE_SIZE=3
MAX_CONCURRENT_GENERATIONS=1

# Reject reference uploads larger than this. 20 MiB covers a short uncompressed clip.
MAX_UPLOAD_BYTES=20971520

# Public Gradio sharing stays off. Future external access is a separate step.
GRADIO_SHARE=false
