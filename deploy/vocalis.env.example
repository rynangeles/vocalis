# Production environment for /opt/vocalis/vocalis.env
# Copy this file on the VM during an approved deployment. Do not copy the
# development .env. systemd loads this file, and process environment values
# override a .env sitting in the application directory.

APP_NAME=Vocalis
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=7860

MODEL_PROVIDER=voxcpm
VOXCPM_MODEL_PATH=/opt/voxcpm2/models

VOCALIS_DATA_DIR=/opt/vocalis/data
VOCALIS_OUTPUT_DIR=/opt/voxcpm2/output
VOCALIS_UPLOAD_DIR=/opt/vocalis/uploads
VOCALIS_LOG_DIR=/opt/vocalis/logs
VOCALIS_DATABASE_PATH=/opt/vocalis/data/history.db

MAX_QUEUE_SIZE=3
MAX_CONCURRENT_GENERATIONS=1
MAX_UPLOAD_BYTES=20971520

# Public Gradio sharing stays off. External access is a separate decision.
GRADIO_SHARE=false
